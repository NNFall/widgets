FROM node:22-bookworm-slim AS qwen-runtime

RUN npm install --global @qwen-code/qwen-code@0.21.0

FROM python:3.11-slim

WORKDIR /app

# AgentRouter accepts the pinned Qwen client used by the verified benchmark,
# while rejecting a generic HTTP client. Copy the already installed runtime so
# the read-only worker never downloads executable code during a model call.
COPY --from=qwen-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=qwen-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
ENV NODE_PATH=/usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@qwen-code/qwen-code/cli-entry.js /usr/local/bin/qwen \
    && qwen --version

# The builder/research image intentionally owns Chromium and its system
# libraries. The production application image remains browser-free.
COPY requirements.txt requirements.builder-lab.txt ./
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir -r requirements.txt -r requirements.builder-lab.txt \
    && playwright install --with-deps chromium \
    && groupadd --gid 10001 kaigo \
    && useradd --uid 10001 --gid kaigo --home-dir /app --no-create-home --no-log-init --shell /usr/sbin/nologin kaigo \
    && chown -R kaigo:kaigo /app /ms-playwright \
    && rm -rf /var/lib/apt/lists/*

# The context copy includes scripts/capture_reference_site.py,
# scripts/analyze_reference_site.py and scripts/smoke_builder_lab.py.
COPY --chown=kaigo:kaigo . .

ENV PYTHONPATH=/app

USER kaigo

CMD ["python", "scripts/run_builder_lab.py"]
