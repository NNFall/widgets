DATABASE_URL=postgresql+asyncpg://widget_admin:change-me@db:5432/widget_platform
POSTGRES_USER=widget_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=widget_platform
# Production releases must replace every placeholder with either a preferred
# immutable registry RepoDigest (name@sha256:<64-hex>) or a direct local Docker
# image ID (sha256:<64-hex>). Mutable tags are development-only.
KAIGO_APP_IMAGE=registry.example/kaigo/app@sha256:replace-with-app-digest
KAIGO_BUILDER_WORKER_IMAGE=registry.example/kaigo/builder-worker@sha256:replace-with-worker-digest
# Rotate BOOT_ID for every rollout before starting the application and worker.
# RELEASE_ID and IMAGE_IDENTITY must describe the immutable reviewed release.
KAIGO_RELEASE_ID=replace-with-reviewed-commit-sha
KAIGO_BUILDER_WORKER_IMAGE_IDENTITY=registry.example/kaigo/builder-worker@sha256:replace-with-worker-digest
KAIGO_BUILDER_WORKER_BOOT_ID=replace-with-random-rollout-uuid
KAIGO_DATABASE_OPS_IMAGE=postgres@sha256:replace-with-postgres-15-alpine-digest
KAIGO_BACKUP_DIR=/srv/kaigo/backups

APP_HOST=0.0.0.0
APP_PORT=8080
MESSAGE_DATABASE_URL=/app/data/dialogs.sqlite3
# This example is fail-closed for production. For local development only,
# explicitly switch to development and set public auth to false if desired.
KAIGO_ENVIRONMENT=production
KAIGO_AUTO_CREATE_SCHEMA=false
KAIGO_PUBLIC_AUTH_ENABLED=true
KAIGO_PUBLIC_BASE_URL=https://kaigo.space
KAIGO_SESSION_COOKIE_NAME=kaigo_session
KAIGO_SESSION_TTL_SECONDS=1209600
# Production startup requires at least one complete pair. Leaving both pairs
# empty or setting only one value from a pair is intentionally a hard error.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Billing is disabled unless both credentials are present. YooKassa's official
# production API origin is fixed in code and cannot be overridden by env.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
YOOKASSA_TIMEOUT_SECONDS=20
# Development-only escape hatch for localhost/http embed origins. Production
# ignores it even when accidentally enabled.
KAIGO_PUBLICATION_ALLOW_INSECURE_ORIGINS=false
# Required when the production visitor chat provider is enabled. Keep the same
# random 32+ byte secret on every application worker.
KAIGO_PUBLICATION_CHAT_SIGNING_SECRET=
KAIGO_PUBLICATION_CHAT_CAPABILITY_TTL_SECONDS=300
KAIGO_PUBLICATION_CHAT_KEY_RATE_LIMIT_REQUESTS=120
KAIGO_PUBLICATION_CHAT_IP_RATE_LIMIT_REQUESTS=60
# Only these reverse proxies may supply X-Forwarded-For. Leave blank for direct
# traffic. Example for local nginx: 127.0.0.0/8,::1/128
KAIGO_PUBLICATION_CHAT_TRUSTED_PROXY_CIDRS=
KAIGO_ENTRY_RATE_LIMIT_REQUESTS=20
KAIGO_ENTRY_RATE_LIMIT_WINDOW_SECONDS=60
KAIGO_ENTRY_MAX_BODY_BYTES=16384
# Required in production and intentionally separate from the publication-chat
# proxy list. Forwarding headers are ignored unless the direct peer is here.
KAIGO_ENTRY_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
KAIGO_OAUTH_CALLBACK_CONCURRENCY=4
# Random 32+ byte operational secret. /api/ready returns 404 without it, before
# opening a database session. Supply it to the edge smoke from a root-only file.
KAIGO_READINESS_TOKEN=

GOOGLE_AI_API_KEY=replace-with-google-ai-studio-key
GOOGLE_AI_MODEL=gemini-3-flash-preview
GOOGLE_AI_STT_MODEL=gemini-3-flash-preview
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_AI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Explicit escape hatch for a private RFC1918/loopback Gemini tunnel only.
# Public HTTP provider URLs remain rejected even when this flag is true.
KAIGO_ALLOW_INSECURE_PROVIDER_PROXY=false
GOOGLE_AI_REQUEST_TIMEOUT=60
GOOGLE_AI_MAX_RETRIES=0

# Isolated Gemini Builder Lab. The lab also accepts GOOGLE_AI_API_KEY above.
GEMINI_API_KEY=
KAIGO_BUILDER_LAB_HOST=127.0.0.1
KAIGO_BUILDER_LAB_PORT=8091
KAIGO_BUILDER_LAB_ALLOW_REMOTE=false
KAIGO_BUILDER_DEFAULT_ENGINE=direct
KAIGO_BUILDER_ENABLE_ANTIGRAVITY=true
KAIGO_BUILDER_RUN_TTL_SECONDS=3600
KAIGO_BUILDER_MAX_RUNS=100
KAIGO_BUILDER_DEMO_PATH=/app/data/builder-demo/latest.json
KAIGO_BUILDER_DEMO_DIR=/app/data/builder-demo/direct-abc-v1
GEMINI_BUILDER_MODEL=gemini-3.6-flash
GEMINI_BUILDER_THINKING_LEVEL=high
# The production worker uses GPT-5.5 for decisions/judging and GLM-5.2 for
# artifact generation/repair. It refuses to start with this flag enabled and
# no AgentRouter key or pinned Qwen executable.
KAIGO_BUILDER_HYBRID_ROUTING_ENABLED=false
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_TIMEOUT_SECONDS=180
AGENTROUTER_QWEN_EXECUTABLE=/usr/local/bin/qwen
AGENTROUTER_GPT_MODEL=gpt-5.5
AGENTROUTER_GLM_MODEL=glm-5.2
AGENTROUTER_GPT_INPUT_PRICE_MICROUSD_PER_MILLION=7000000
AGENTROUTER_GPT_OUTPUT_PRICE_MICROUSD_PER_MILLION=7000000
AGENTROUTER_GLM_INPUT_PRICE_MICROUSD_PER_MILLION=6000000
AGENTROUTER_GLM_OUTPUT_PRICE_MICROUSD_PER_MILLION=6000000
GEMINI_VISUAL_CRITIC_MODEL=gemini-3.6-flash
GEMINI_VISUAL_CRITIC_THINKING_LEVEL=high
GEMINI_VISUAL_CRITIC_TIMEOUT_SECONDS=60
GEMINI_REFERENCE_ANALYZER_MODEL=gemini-3.6-flash
GEMINI_REFERENCE_ANALYZER_THINKING_LEVEL=high
KAIGO_REFERENCE_MAX_PAGES=1
KAIGO_REFERENCE_MAX_DEPTH=0
KAIGO_REFERENCE_TIMEOUT_SECONDS=600
KAIGO_REFERENCE_PAGE_TIMEOUT_SECONDS=45
KAIGO_REFERENCE_MAX_TOTAL_BYTES=104857600
KAIGO_REFERENCE_MAX_PAGE_BYTES=26214400
KAIGO_REFERENCE_MAX_RETRIES=1
KAIGO_REFERENCE_MAX_SCROLL_STEPS=40
KAIGO_REFERENCE_SCROLL_DELAY_MS=750
KAIGO_REFERENCE_WARMUP_MS=5000
KAIGO_REFERENCE_FINAL_SETTLE_MS=1500
KAIGO_REFERENCE_MAX_SCROLL_HEIGHT=50000
KAIGO_REFERENCE_TRACE_TTL_SECONDS=3600
KAIGO_REFERENCE_RESPECT_ROBOTS=true
CRAWLEE_MEMORY_MBYTES=4096
CRAWLEE_DISABLE_BROWSER_SANDBOX=true
KAIGO_BROWSER_AUDIT_TIMEOUT_MS=10000
KAIGO_BROWSER_AUDIT_TOTAL_TIMEOUT_SECONDS=120
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_THINKING_LEVEL=medium
GEMINI_CHAT_TIMEOUT_SECONDS=45
# Required as positive integers by the production generation worker. Fill from
# the current visitor-chat model price sheet. The worker-specific values below
# keep generation accounting correct when the builder uses a different model.
GEMINI_INPUT_PRICE_MICROUSD_PER_MILLION=
GEMINI_OUTPUT_PRICE_MICROUSD_PER_MILLION=
GEMINI_BUILDER_INPUT_PRICE_MICROUSD_PER_MILLION=
GEMINI_BUILDER_OUTPUT_PRICE_MICROUSD_PER_MILLION=
KAIGO_CHAT_SESSION_SECRET=
KAIGO_CHAT_SESSION_TTL_SECONDS=3600
KAIGO_CHAT_MAX_SESSIONS=500
KAIGO_CHAT_RATE_LIMIT_REQUESTS=12
KAIGO_CHAT_USER_RATE_LIMIT_REQUESTS=60
KAIGO_CHAT_IP_RATE_LIMIT_REQUESTS=60
KAIGO_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
KAIGO_CHAT_MAX_REQUESTS_PER_SESSION=40
KAIGO_CHAT_GLOBAL_CONCURRENCY=4
KAIGO_CHAT_SECURE_COOKIE=true
GEMINI_BUILDER_TEMPERATURE=0.9
GEMINI_BUILDER_MAX_REPAIRS=3
GEMINI_ANTIGRAVITY_AGENT=antigravity-preview-05-2026
GEMINI_ANTIGRAVITY_TIMEOUT_SECONDS=900
GEMINI_ANTIGRAVITY_MAX_SNAPSHOT_BYTES=10485760
GEMINI_ANTIGRAVITY_MAX_TOTAL_TOKENS=500000
PROMPT_GOOGLE_DOC_URL=https://docs.google.com/document/d/your-document-id/edit
SERVICE_ACCOUNT_FILE=credentials.json
DEFAULT_SYSTEM_PROMPT=Ты полезный AI-ассистент. Отвечай кратко, понятно и по делу.

ADMIN_PASSWORD=replace-with-admin-password
ADMIN_EMAILS=admin@example.com

# Five-day private generation evidence. Keep disabled until the dedicated
# host directory, verified operator allowlist and cleanup timer are ready.
KAIGO_GENERATION_FORENSICS_ENABLED=false
KAIGO_GENERATION_FORENSICS_ROOT=/var/lib/kaigo/generation-forensics
KAIGO_GENERATION_FORENSICS_HOST_DIR=./data/generation-forensics
KAIGO_GENERATION_FORENSICS_TTL_HOURS=120
KAIGO_GENERATION_FORENSICS_MAX_BYTES=10737418240
KAIGO_GENERATION_FORENSICS_ADMIN_EMAILS=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ADMIN_BOT_TOKEN=
ADMIN_CHANNEL_ID=
