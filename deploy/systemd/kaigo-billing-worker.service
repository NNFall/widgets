[Unit]
Description=Kaigo payment reconciliation and feature-flagged renewal worker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kaigo
Environment=COMPOSE_PROJECT_NAME=kaigo
EnvironmentFile=/etc/kaigo/billing-worker.env
ExecStart=/usr/bin/docker compose --profile saas-billing-worker up --no-build --no-deps billing-worker
ExecStop=/usr/bin/docker compose --profile saas-billing-worker stop -t 30 billing-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/kaigo/data /opt/kaigo/logs

[Install]
WantedBy=multi-user.target
