[Unit]
Description=Kaigo private Codex CLI provider bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kaigo/current
EnvironmentFile=-/etc/kaigo/codex-bridge.env
Environment=PYTHONPATH=/opt/kaigo/current
Environment=CODEX_HOME=/root/.codex
Environment=KAIGO_CODEX_BRIDGE_MODEL=gpt-5.6-luna
Environment=KAIGO_CODEX_BRIDGE_REASONING_EFFORT=max
Environment=KAIGO_CODEX_BRIDGE_MAX_CONCURRENCY=3
Environment=KAIGO_CODEX_BRIDGE_TIMEOUT_SECONDS=900
Environment=KAIGO_CODEX_BRIDGE_SOCKET_PATH=/run/kaigo-codex/bridge.sock
Environment=KAIGO_CODEX_BRIDGE_SOCKET_GID=10001
Environment=KAIGO_CODEX_BRIDGE_STATE_ROOT=/var/lib/kaigo-codex-bridge
Environment=KAIGO_CODEX_BRIDGE_WORK_ROOT=/var/lib/kaigo-codex-bridge/work
RuntimeDirectory=kaigo-codex
RuntimeDirectoryMode=0770
StateDirectory=kaigo-codex-bridge
StateDirectoryMode=0700
ExecStart=/opt/kaigo/codex-bridge-venv/bin/python /opt/kaigo/current/scripts/run_codex_bridge.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/kaigo-codex /var/lib/kaigo-codex-bridge /root/.codex

[Install]
WantedBy=multi-user.target
